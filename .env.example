# Copy to .env — .env is gitignored and must never be committed.

# Normalization. CLAUDE.md invariant 1: the model normalizes and never charges.
# The provider is swappable behind the createExtractor seam; only the selected
# one's key is needed. Default is gemini, chosen by the bake-off in OBSTACLES.md.
GEMINI_API_KEY=
GROQ_API_KEY=
# NORMALIZER_PROVIDER=gemini   # gemini | groq

# Razorpay TEST MODE ONLY. CLAUDE.md invariant 5 — no live keys in this repo,
# ever. A key not starting with rzp_test_ is a mistake, not a configuration.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret from RAZORPAY_KEY_SECRET: it is set per-webhook in the
# dashboard and is what the X-Razorpay-Signature HMAC is keyed by. Using the API
# key secret here produces a mismatch that looks exactly like an attack.
# Unset means the endpoint refuses every event (503), never accepts unverified.
RAZORPAY_WEBHOOK_SECRET=

# Mandates. HMAC-SHA256 over the canonical mandate JSON — see lib/mandate/sign.ts.
# A SHARED secret, so the verifier could have issued what it verifies. Sound for
# this project, where the seller issues on a buyer's instruction; the real shape
# is asymmetric and is named as a gap in the README rather than implied away.
# Unset means the server refuses every mandate and cannot issue one, which is
# the correct answer for a server that cannot verify.
MANDATE_SIGNING_SECRET=
