# Copy to .env — .env is gitignored and must never be committed.

# Any Postgres. The code uses no provider-specific feature; Neon is the current
# one, chosen because its free tier auto-resumes from idle (OBSTACLES.md).
#
# PREFER sslmode=verify-full. `require` behaves identically today — pg treats it
# as an alias — but it prints a deprecation warning on every connection, which
# lands in the middle of demo output, and it will mean something weaker once
# pg v9 adopts libpq semantics.
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full

# The agent's bearer credential. Mint one with:
#   npm run agent:issue -- <agent_id> <merchant_id> "<label>"
# It is printed once and stored only as a hash, so a lost token is re-minted,
# never recovered. The MCP server reads it from this file — do NOT also set it
# in .mcp.json, because process.loadEnvFile() will not override a value that is
# already present, and an unexpanded ${AGENT_TOKEN} counts as present.
AGENT_TOKEN=

# Ingest lock. In production the merchant id in the upload form is IGNORED and
# every anonymous upload lands on INGEST_SANDBOX_MERCHANT (default mer_try), so
# a public deployment cannot have its demo catalogue replaced by a stranger.
# Locked by default rather than by configuration: a guard you have to switch on
# is a guard that ships off.
#
# INGEST_KEY is the way back in for whoever owns the deployment — a request
# sending it as X-Ingest-Key may name its own merchant, which is how the real
# catalogue gets seeded. Unset means nobody can, including you.
# INGEST_SANDBOX_MERCHANT=mer_try
# INGEST_KEY=
#
# Which shop /catalogue is about. Unset follows your own last upload, which is
# what you want locally. On a public URL set it, or the page shows whatever a
# visitor uploaded last while the audit trail describes a different merchant.
# CATALOGUE_MERCHANT=mer_live

# Normalization. CLAUDE.md invariant 1: the model normalizes and never charges.
# The provider is swappable behind the createExtractor seam; only the selected
# one's key is needed. Default is gemini, chosen by the bake-off in OBSTACLES.md.
GEMINI_API_KEY=
GROQ_API_KEY=
# NORMALIZER_PROVIDER=gemini   # gemini | groq

# Razorpay TEST MODE ONLY. CLAUDE.md invariant 5 — no live keys in this repo,
# ever. A key not starting with rzp_test_ is a mistake, not a configuration.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret from RAZORPAY_KEY_SECRET: it is set per-webhook in the
# dashboard and is what the X-Razorpay-Signature HMAC is keyed by. Using the API
# key secret here produces a mismatch that looks exactly like an attack.
# Unset means the endpoint refuses every event (503), never accepts unverified.
RAZORPAY_WEBHOOK_SECRET=

# Mandates. HMAC-SHA256 over the canonical mandate JSON — see lib/mandate/sign.ts.
# A SHARED secret, so the verifier could have issued what it verifies. Sound for
# this project, where the seller issues on a buyer's instruction; the real shape
# is asymmetric and is named as a gap in the README rather than implied away.
# Unset means the server refuses every mandate and cannot issue one, which is
# the correct answer for a server that cannot verify.
MANDATE_SIGNING_SECRET=
